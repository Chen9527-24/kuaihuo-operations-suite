# Copy to .env. Configure your own backend; log in through the GUI.
CORE_NEXUS_API_BASE_URL=http://localhost:3000
ACS_HTTP_TRUST_ENV=0

# Install Chromium once with: python -m playwright install chromium
ACS_PLAYWRIGHT_AUTO_INSTALL=0
ACS_ALLOW_SYSTEM_BROWSER_FALLBACK=0
ACS_GUI_EXTERNAL_BROWSER=0
ACS_GUI_VERBOSE_LOG=0

# Speech recognition is optional. Set a local faster-whisper model folder and ffmpeg path.
# Without a model/path, speech mode gives a configuration error instead of downloading.
WHISPER_MODEL=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TRANSCRIPT_LANGUAGE=zh
ACS_FFMPEG_PATH=
ACS_ALLOW_WHISPER_DOWNLOAD=0

# Headless collection in GUI; no independent visible browser by default.
ACS_SPEECH_HEADLESS=1
ACS_SPEECH_RETRY_VISIBLE_ON_FAIL=0
