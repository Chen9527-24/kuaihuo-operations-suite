# Copy to .env. Configure your own Core Nexus; never commit .env.
CORE_NEXUS_API_BASE_URL=http://localhost:3000

DM_ACTIVE_SCAN_INTERVAL_MS=1200
DM_TAB_SCAN_INTERVAL_MS=3000
DM_IDLE_SCAN_MIN_MS=40000
DM_IDLE_SCAN_MAX_MS=90000
DM_IDLE_LOG_EVERY_N=1
DM_IDLE_HEARTBEAT_INTERVAL_MS=90000
DM_DEBUG_VERBOSE=0

# Optional legacy Coze path. Disabled unless explicitly enabled AND both fields set.
# Normal production replies use Core Nexus and its own AI configuration.
COZE_ENABLED=0
COZE_API_URL=https://api.coze.cn/v1/workflow/run
COZE_WORKFLOW_ID=
COZE_TOKEN=
COZE_INPUT_KEY=input
