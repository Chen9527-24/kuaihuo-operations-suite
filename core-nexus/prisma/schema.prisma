  updatedBy User?                    @relation("IndustryAiCapabilityPackVersionUpdater", fields: [updatedById], references: [id])
  scenarios IndustryAiScenario[]
  guardrails IndustryAiGuardrail[]
  robots IndustryAiRobot[]
  testSessions IndustryAiTestSession[]

  @@unique([packId, versionNo])
  @@index([packId, status])
  @@index([status])
}

model IndustryAiScenario {
  id                String    @id @default(cuid())
  versionId         String
  code              String    @db.VarChar(64)
  name              String    @db.VarChar(100)
  channel           String    @default("BOTH") @db.VarChar(16)
