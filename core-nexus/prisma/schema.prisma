model IndustryAiRobot {
  id                       String    @id @default(cuid())
  tenantId                 String
  name                     String    @db.VarChar(100)
  channel                  String    @db.VarChar(16) // DM / COMMENT
  industryCode             String    @db.VarChar(64)
  industryName             String    @db.VarChar(100)
  capabilityPackId         String
  capabilityPackVersionId  String
  capabilityPackSnapshot   Json
  brandName                String?   @db.VarChar(100)
  businessProfile          String?
  businessRules            String?
  // V4.2：店铺结构化处理规则（发货、物流、改地址、售后、退款、投诉）；仅用于 IndustryAiRobot。
  storeServiceRules        Json?
  // V4.1：行业范围和敏感消息的独立决策策略，仅作用于 IndustryAiRobot。
  outOfScopePolicy         String    @default("GUIDE_BACK") @db.VarChar(32) // GUIDE_BACK / NO_REPLY / HANDOFF
  outOfScopeReply          String?
  sensitiveMessagePolicy   String    @default("HANDOFF") @db.VarChar(32) // HANDOFF / NO_REPLY
  sensitiveReply            String?
