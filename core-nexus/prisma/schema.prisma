// 行业 AI 机器人模块与既有评论/私信/截流机器人完全隔离：
// 仅用于行业能力包配置与 DeepSeek 后台聊天测试，当前不参与任何已有机器人执行或消息发送链路。
model IndustryAiCapabilityPack {
  id           String    @id @default(cuid())
  tenantId     String
  name         String    @db.VarChar(100)
  industryCode String    @db.VarChar(64)
  industryName String    @db.VarChar(100)
  channel      String    @default("BOTH") @db.VarChar(16) // DM / COMMENT / BOTH
  description  String?
  status       String    @default("DRAFT") @db.VarChar(32) // DRAFT / PUBLISHED / ARCHIVED
  createdById  String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  createdBy User   @relation("IndustryAiCapabilityPackCreator", fields: [createdById], references: [id])
  versions IndustryAiCapabilityPackVersion[]
  robots   IndustryAiRobot[]

  @@index([tenantId, status])
  @@index([tenantId, industryCode])
  @@index([deletedAt])
}

model IndustryAiCapabilityPackVersion {
  id              String    @id @default(cuid())
  packId          String
  versionNo       Int
  status          String    @default("DRAFT") @db.VarChar(32) // DRAFT / PUBLISHED / ARCHIVED
