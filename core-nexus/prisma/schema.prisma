generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String    @id @default(cuid())
  name             String    @db.VarChar(100)
  code             String    @unique @db.VarChar(64)
  status           String    @default("ACTIVE") @db.VarChar(32) // tenant_status
  industry         String?   @db.VarChar(255)
  productIntro     String?
  coreSellingPoint String?
  startedAt        DateTime
  expiredAt        DateTime
  remark           String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users         User[]
  memberships   UserTenantMembership[]
  mediaAccounts MediaAccount[]
  dailyTasks    DailyTask[]
  robotDevices  RobotDevice[]
  robotAuths    RobotPlatformAuth[]
  robots        Robot[]
  robotRuns     RobotRun[]
  appUsers      AppUser[]
  withdrawals   AppUserWithdrawal[]
  testDataBatches TestDataBatch[]

  interceptCaptureRecords    InterceptCaptureRecord[]
  interceptCaptureViewPresets InterceptCaptureViewPreset[]
  industryAiCapabilityPacks IndustryAiCapabilityPack[]
  industryAiRobots IndustryAiRobot[]
  industryAiTestSessions IndustryAiTestSession[]
  industryAiFixedReplyRules IndustryAiFixedReplyRule[]
  customerServiceAssets CustomerServiceAsset[]
  customerServiceRolePrototypes CustomerServiceRolePrototype[]
  customerServiceIndustryNodes CustomerServiceIndustryNode[]
  customerServiceMerchantRoles CustomerServiceMerchantRole[]
  customerServiceRoleModuleInstances CustomerServiceRoleModuleInstance[]
  customerServiceResponseRules CustomerServiceResponseRule[]
  customerServiceQualityRules CustomerServiceQualityRule[]
  customerServiceEvaluationCases CustomerServiceEvaluationCase[]
  customerServiceCalibrationRecords CustomerServiceCalibrationRecord[]
  customerServiceCalibrationProfiles CustomerServiceCalibrationProfile[]
  customerServiceIntentDefinitions CustomerServiceIntentDefinition[]
  customerServiceIntentCandidates  CustomerServiceIntentCandidate[]
  customerServiceTuningSessions CustomerServiceTuningSession[]
  customerServiceDataGovernanceRuns CustomerServiceDataGovernanceRun[]
  customerServiceRuntimeReplyRequests CustomerServiceRuntimeReplyRequest[]
  customerServiceReplyTraces CustomerServiceReplyTrace[]
  customerServiceReplyFeedbacks CustomerServiceReplyFeedback[]
  customerServiceStoreProfiles CustomerServiceStoreProfile[]
  customerServiceAccountProfiles CustomerServiceAccountProfile[]
  customerServiceLanguagePolicies CustomerServiceLanguagePolicy[]
  customerServiceKnowledgeEntries CustomerServiceKnowledgeEntry[]
  customerServiceKnowledgeCollections CustomerServiceKnowledgeCollection[]
  customerServiceKnowledgeBindings CustomerServiceKnowledgeBinding[]
  customerServiceKnowledgeRevisionDrafts CustomerServiceKnowledgeRevisionDraft[]

  @@index([status])
  @@index([expiredAt])
  @@index([deletedAt])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  username     String    @unique @db.VarChar(32)
  passwordHash String
  displayName  String    @db.VarChar(50)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?
  avatarFileId String?
  status       String    @default("ENABLED") @db.VarChar(32) // user_status
  remark       String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                      Tenant?                @relation(fields: [tenantId], references: [id])
  memberships                 UserTenantMembership[]
  roles                       UserRole[]
  uploads                     UploadFile[]           @relation("UploaderFiles")
  createdTasks                DailyTask[]            @relation("DailyTaskCreator")
  assignedComments            TaskComment[]          @relation("CommentAssignee")
  settledParticipants         TaskParticipant[]      @relation("TaskParticipantSettler")
  operatedAppUserRestrictions AppUserRestriction[]   @relation("AppUserRestrictionOperator")
  authorizedRobotAuths        RobotPlatformAuth[]    @relation("RobotAuthAuthorizedBy")
  createdRobots               Robot[]                @relation("RobotCreator")
  createdRobotRuns            RobotRun[]             @relation("RobotRunCreator")
  interceptCaptureViewPresets InterceptCaptureViewPreset[]
  industryAiCreatedCapabilityPacks IndustryAiCapabilityPack[] @relation("IndustryAiCapabilityPackCreator")
  industryAiCreatedCapabilityPackVersions IndustryAiCapabilityPackVersion[] @relation("IndustryAiCapabilityPackVersionCreator")
  industryAiUpdatedCapabilityPackVersions IndustryAiCapabilityPackVersion[] @relation("IndustryAiCapabilityPackVersionUpdater")
  industryAiCreatedRobots IndustryAiRobot[] @relation("IndustryAiRobotCreator")
  industryAiTestSessions IndustryAiTestSession[] @relation("IndustryAiTestSessionCreator")
  customerServiceCreatedAssets CustomerServiceAsset[] @relation("CustomerServiceAssetCreator")
  customerServiceUpdatedAssets CustomerServiceAsset[] @relation("CustomerServiceAssetUpdater")
  customerServiceCreatedAssetVersions CustomerServiceAssetVersion[] @relation("CustomerServiceAssetVersionCreator")
  customerServicePublishedAssetVersions CustomerServiceAssetVersion[] @relation("CustomerServiceAssetVersionPublisher")
  customerServiceCreatedRolePrototypes CustomerServiceRolePrototype[] @relation("CustomerServiceRolePrototypeCreator")
  customerServiceUpdatedRolePrototypes CustomerServiceRolePrototype[] @relation("CustomerServiceRolePrototypeUpdater")
  customerServiceCreatedIndustryNodes CustomerServiceIndustryNode[] @relation("CustomerServiceIndustryNodeCreator")
  customerServiceUpdatedIndustryNodes CustomerServiceIndustryNode[] @relation("CustomerServiceIndustryNodeUpdater")
  customerServiceCreatedMerchantRoles CustomerServiceMerchantRole[] @relation("CustomerServiceMerchantRoleCreator")
  customerServiceUpdatedMerchantRoles CustomerServiceMerchantRole[] @relation("CustomerServiceMerchantRoleUpdater")
  customerServiceCreatedRoleModuleInstances CustomerServiceRoleModuleInstance[] @relation("CustomerServiceRoleModuleInstanceCreator")
  customerServiceUpdatedRoleModuleInstances CustomerServiceRoleModuleInstance[] @relation("CustomerServiceRoleModuleInstanceUpdater")
  customerServiceCreatedResponseRules CustomerServiceResponseRule[] @relation("CustomerServiceResponseRuleCreator")
  customerServiceUpdatedResponseRules CustomerServiceResponseRule[] @relation("CustomerServiceResponseRuleUpdater")
  customerServiceCreatedQualityRules CustomerServiceQualityRule[] @relation("CustomerServiceQualityRuleCreator")
  customerServiceUpdatedQualityRules CustomerServiceQualityRule[] @relation("CustomerServiceQualityRuleUpdater")
  customerServiceCreatedEvaluationCases CustomerServiceEvaluationCase[] @relation("CustomerServiceEvaluationCaseCreator")
  customerServiceUpdatedEvaluationCases CustomerServiceEvaluationCase[] @relation("CustomerServiceEvaluationCaseUpdater")
  customerServiceCreatedCalibrationRecords CustomerServiceCalibrationRecord[] @relation("CustomerServiceCalibrationRecordCreator")
  customerServiceUpdatedCalibrationRecords CustomerServiceCalibrationRecord[] @relation("CustomerServiceCalibrationRecordUpdater")
  customerServiceAnalyzedCalibrationRecords CustomerServiceCalibrationRecord[] @relation("CustomerServiceCalibrationRecordAnalyzer")
  customerServiceAppliedCalibrationRecords CustomerServiceCalibrationRecord[] @relation("CustomerServiceCalibrationRecordApplier")
  customerServiceCreatedCalibrationProfiles CustomerServiceCalibrationProfile[] @relation("CustomerServiceCalibrationProfileCreator")
  customerServiceUpdatedCalibrationProfiles CustomerServiceCalibrationProfile[] @relation("CustomerServiceCalibrationProfileUpdater")
  customerServiceCreatedIntentDefinitions CustomerServiceIntentDefinition[] @relation("CustomerServiceIntentDefinitionCreator")
  customerServiceUpdatedIntentDefinitions CustomerServiceIntentDefinition[] @relation("CustomerServiceIntentDefinitionUpdater")
  customerServiceCreatedTuningSessions CustomerServiceTuningSession[] @relation("CustomerServiceTuningSessionCreator")
  customerServiceCreatedTuningAnalyses CustomerServiceTuningAnalysis[] @relation("CustomerServiceTuningAnalysisCreator")
  customerServiceCreatedStoreProfiles CustomerServiceStoreProfile[] @relation("CustomerServiceStoreProfileCreator")
  customerServiceUpdatedStoreProfiles CustomerServiceStoreProfile[] @relation("CustomerServiceStoreProfileUpdater")
  customerServiceCreatedAccountProfiles CustomerServiceAccountProfile[] @relation("CustomerServiceAccountProfileCreator")
  customerServiceUpdatedAccountProfiles CustomerServiceAccountProfile[] @relation("CustomerServiceAccountProfileUpdater")
  customerServiceCreatedLanguagePolicies CustomerServiceLanguagePolicy[] @relation("CustomerServiceLanguagePolicyCreator")
  customerServiceUpdatedLanguagePolicies CustomerServiceLanguagePolicy[] @relation("CustomerServiceLanguagePolicyUpdater")
  customerServiceCreatedReplyTraces CustomerServiceReplyTrace[] @relation("CustomerServiceReplyTraceCreator")
  customerServiceCreatedReplyFeedbacks CustomerServiceReplyFeedback[] @relation("CustomerServiceReplyFeedbackCreator")
  customerServiceCreatedKnowledgeEntries CustomerServiceKnowledgeEntry[] @relation("CustomerServiceKnowledgeEntryCreator")
  customerServiceUpdatedKnowledgeEntries CustomerServiceKnowledgeEntry[] @relation("CustomerServiceKnowledgeEntryUpdater")
  customerServiceCreatedKnowledgeCollections CustomerServiceKnowledgeCollection[] @relation("CustomerServiceKnowledgeCollectionCreator")
  customerServiceUpdatedKnowledgeCollections CustomerServiceKnowledgeCollection[] @relation("CustomerServiceKnowledgeCollectionUpdater")
  customerServiceCreatedKnowledgeBindings CustomerServiceKnowledgeBinding[] @relation("CustomerServiceKnowledgeBindingCreator")
  customerServiceCreatedKnowledgeRevisionDrafts CustomerServiceKnowledgeRevisionDraft[] @relation("CustomerServiceKnowledgeRevisionDraftCreator")
  customerServiceUpdatedKnowledgeRevisionDrafts CustomerServiceKnowledgeRevisionDraft[] @relation("CustomerServiceKnowledgeRevisionDraftUpdater")
  customerServiceVerifiedKnowledgeRevisionDrafts CustomerServiceKnowledgeRevisionDraft[] @relation("CustomerServiceKnowledgeRevisionDraftVerifier")
  customerServicePublishedKnowledgeRevisionDrafts CustomerServiceKnowledgeRevisionDraft[] @relation("CustomerServiceKnowledgeRevisionDraftPublisher")

  @@index([tenantId])
  @@index([phone])
  @@index([status])
  @@index([deletedAt])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  scope       String   @default("PLATFORM") @db.VarChar(32) // PLATFORM / TENANT
  status      String   @default("ENABLED") @db.VarChar(32) // role_status
  description String?
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@index([tenantId])
  @@index([scope])
  @@index([status])
}

model Permission {
  id        String   @id @default(cuid())
  parentId  String?
  code      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(100)
  group     String   @default("system") @db.VarChar(32)
  type      String   @default("BUTTON") @db.VarChar(32) // permission_type
  status    String   @default("ENABLED") @db.VarChar(32) // permission_validation_status
  sort      Int      @default(0)
  routePath String?
  component String?
  icon      String?
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Permission?      @relation("PermissionTree", fields: [parentId], references: [id])
  children Permission[]     @relation("PermissionTree")
  roles    RolePermission[]

  @@index([parentId])
  @@index([type])
  @@index([status])
}

model CustomerLead {
  id                String                 @id @default(cuid())
  companyName       String                 @db.VarChar(150)
  contactName       String?                @db.VarChar(80)
  contactPosition   String?                @db.VarChar(80)
  contactInfo       String?                @db.VarChar(200)
  leadSource        String                 @default("UNKNOWN") @db.VarChar(32)
  leadSourceDetail  String?                @db.VarChar(300)
  companyAddress    String?                @db.VarChar(500)
  primaryCategories String[]               @default([])
  requestedFeatures String?
  currentSolution   String?
  notWonReason      String?
  followUpStatus    String                 @default("PENDING_CONTACT") @db.VarChar(32)
  followUpValue     String                 @default("NURTURE") @db.VarChar(32)
  followUpOwner     String?                @db.VarChar(80)
  // 当前待办的下次计划，不属于实际沟通历史。
  nextFollowUpAt    DateTime?
  nextFollowUpPlan  String?
  // 首次与最近一次实际沟通的投影字段；完整历史以 CustomerLeadFollowUp 为准。
  firstFollowUpAt   DateTime?
  lastFollowUpAt    DateTime?
  lastFollowUpNote  String?
  followUpCount     Int                    @default(0)
  remark            String?
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  followUps         CustomerLeadFollowUp[]
  websiteSubmission WebsiteContactSubmission?

  @@index([companyName])
  @@index([leadSource])
  @@index([followUpStatus])
  @@index([followUpValue])
  @@index([followUpOwner])
  @@index([nextFollowUpAt])
  @@index([firstFollowUpAt])
  @@index([lastFollowUpAt])
  @@index([deletedAt])
}

model CustomerLeadFollowUp {
  id               String       @id @default(cuid())
  customerLeadId   String
  followedUpAt     DateTime
  followUpMethod   String?      @db.VarChar(32)
  followUpOwner    String?      @db.VarChar(80)
  summary          String
  followUpStatus   String       @db.VarChar(32)
  followUpValue    String       @db.VarChar(32)
  nextFollowUpAt   DateTime?
  nextFollowUpPlan String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  customerLead CustomerLead @relation(fields: [customerLeadId], references: [id], onDelete: Cascade)

  @@index([customerLeadId, followedUpAt])
  @@index([followedUpAt])
  @@index([followUpOwner])
}

/// 官网全局内容配置。PC 只编辑草稿，公开站点只读取已发布内容；两者分离，避免未完成内容直接上线。
model WebsiteConfiguration {
  id                String    @id @default("official-website") @db.VarChar(50)
  draftContent      Json?
  publishedContent  Json?
  draftRevision     Int       @default(0)
  publishedRevision Int       @default(0)
  updatedById       String?
  publishedById     String?
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// 官网联系表单的不可覆盖原始快照。业务跟进继续使用 CustomerLead，来源证据和投放参数保留在这里。
model WebsiteContactSubmission {
  id                       String   @id @default(cuid())
  customerLeadId           String   @unique
  requestId                String   @unique @db.VarChar(64)
  submittedCompanyName     String   @db.VarChar(150)
  submittedContactName     String?  @db.VarChar(80)
  submittedContactInfo     String   @db.VarChar(200)
  businessOverview         String
  operatingAccounts        String?
  challenge                String   @db.VarChar(200)
  pageUrl                  String?  @db.VarChar(1000)
  referrer                 String?  @db.VarChar(1000)
  utmSource                String?  @db.VarChar(200)
  utmMedium                String?  @db.VarChar(200)
  utmCampaign              String?  @db.VarChar(200)
  utmTerm                  String?  @db.VarChar(200)
  utmContent               String?  @db.VarChar(200)
  ipHash                   String?  @db.VarChar(64)
  userAgent                String?  @db.VarChar(500)
  privacyConsentAt         DateTime
  viewedAt                 DateTime?
  viewedById               String?
  createdAt                DateTime @default(now())

  customerLead CustomerLead @relation(fields: [customerLeadId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([viewedAt, createdAt])
  @@index([utmSource])
  @@index([utmCampaign])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model DictType {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(100)
  status    String   @default("ENABLED") @db.VarChar(32)
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items DictItem[]

  @@index([status])
}

model DictItem {
  id        String   @id @default(cuid())
  typeCode  String   @db.VarChar(64)
  label     String   @db.VarChar(100)
  value     String   @db.VarChar(64)
  color     String?
  sort      Int      @default(0)
  status    String   @default("ENABLED") @db.VarChar(32)
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type DictType @relation(fields: [typeCode], references: [code], onDelete: Cascade)

  @@unique([typeCode, value])
  @@index([typeCode, status])
}

model MediaAccount {
  id          String    @id @default(cuid())
  tenantId    String
  platform    String    @db.VarChar(32) // media_platform
  accountId   String    @db.VarChar(100)
  accountName String    @db.VarChar(100)
  status      String    @default("ENABLED") @db.VarChar(32)
  positioning String?
  remark      String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  dailyTasks DailyTask[]

  @@index([tenantId, platform])
  @@index([status])
  @@index([deletedAt])
}

model RobotDevice {
  id               String    @id @default(cuid())
  tenantId         String
  name             String    @db.VarChar(100)
  platform         String?   @db.VarChar(32)
  deviceCode       String    @unique @db.VarChar(64)
  deviceSecretHash String?   @db.VarChar(255)
  status           String    @default("OFFLINE") @db.VarChar(32) // robot_device_status
  clientVersion    String?   @db.VarChar(32)
  osName           String?   @db.VarChar(64)
  ip               String?
  lastHeartbeatAt  DateTime?
  remark           String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  auths  RobotPlatformAuth[]
  robots Robot[]
  runs   RobotRun[]

  @@index([tenantId, status])
  @@index([platform])
  @@index([lastHeartbeatAt])
  @@index([deletedAt])
}

model UserTenantMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  status    String   @default("ENABLED") @db.VarChar(32)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId, status])
  @@index([tenantId, status])
}

model RobotPlatformAuth {
  id                 String    @id @default(cuid())
  tenantId           String
  platform           String    @db.VarChar(32)
  authType           String    @default("QR_SESSION") @db.VarChar(32)
  accountUid         String?   @db.VarChar(100)
  accountName        String?   @db.VarChar(100)
  accountAvatarUrl   String?
  status             String    @default("UNBOUND") @db.VarChar(32) // robot_auth_status
  sessionData        String?
  sessionExpiresAt   DateTime?
  authorizedAt       DateTime?
  authorizedByUserId String?
  deviceId           String?
  lastVerifiedAt     DateTime?
  revokedAt          DateTime?
  remark             String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  authorizedBy User?        @relation("RobotAuthAuthorizedBy", fields: [authorizedByUserId], references: [id])
  device       RobotDevice? @relation(fields: [deviceId], references: [id])
  robots       Robot[]
  runs         RobotRun[]

  @@index([tenantId, platform])
  @@index([status])
  @@index([deviceId])
  @@index([sessionExpiresAt])
  @@index([deletedAt])
}

model Robot {
  id              String    @id @default(cuid())
  tenantId        String
  name            String    @db.VarChar(100)
  type            String    @db.VarChar(32) // robot_type
  platform        String    @db.VarChar(32)
  status          String    @default("DRAFT") @db.VarChar(32) // robot_status
  authId          String?
  deviceId        String?
  expireAt        DateTime?
  startedAt       DateTime?
  stoppedAt       DateTime?
  stopReason      String?   @db.VarChar(32) // robot_stop_reason
  lastHeartbeatAt DateTime?
  lastError       String?
  config          Json?
  remark          String?
  deletedAt       DateTime?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  auth      RobotPlatformAuth? @relation(fields: [authId], references: [id])
  device    RobotDevice?       @relation(fields: [deviceId], references: [id])
  createdBy User               @relation("RobotCreator", fields: [createdById], references: [id])
  runs      RobotRun[]

  interceptCaptureRecords InterceptCaptureRecord[]

  @@index([tenantId, platform])
  @@index([tenantId, type])
  @@index([status])
  @@index([authId])
  @@index([deviceId])
  @@index([expireAt])
  @@index([deletedAt])
}

model RobotRun {
  id              String    @id @default(cuid())
  tenantId        String
  robotId         String
  authId          String?
  deviceId        String?
  createdById     String?
  runToken        String    @unique @db.VarChar(64)
  status          String    @default("RUNNING") @db.VarChar(32) // robot_run_status
  stopReason      String?   @db.VarChar(32) // robot_stop_reason
  lastHeartbeatAt DateTime?
  startedAt       DateTime  @default(now())
  stoppedAt       DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  robot     Robot              @relation(fields: [robotId], references: [id], onDelete: Cascade)
  auth      RobotPlatformAuth? @relation(fields: [authId], references: [id])
  device    RobotDevice?       @relation(fields: [deviceId], references: [id])
  createdBy User?              @relation("RobotRunCreator", fields: [createdById], references: [id])

  @@index([tenantId, status])
  @@index([robotId, status])
  @@index([authId])
  @@index([deviceId])
  @@index([startedAt])
}

model UploadFile {
  id            String   @id @default(cuid())
  uploaderId    String
  scene         String?  @db.VarChar(64) // file_scene
  status        String   @default("TEMP") @db.VarChar(32) // TEMP / ACTIVE / DELETED
  storageDriver String   @db.VarChar(16)
  bucket        String?
  objectKey     String
  originalName  String
  mimeType           String   @db.VarChar(120)
  size               Int
  url                String
  thumbnailObjectKey String?
  thumbnailMimeType  String?  @db.VarChar(120)
  thumbnailSize      Int?
  imageWidth         Int?
  imageHeight        Int?
  createdAt          DateTime @default(now())

  uploader User        @relation("UploaderFiles", fields: [uploaderId], references: [id], onDelete: Cascade)
  usages   FileUsage[]

  @@index([uploaderId, createdAt])
  @@index([scene])
  @@index([status])
}

model FileUsage {
  id        String   @id @default(cuid())
  fileId    String
  bizType   String   @db.VarChar(64)
  bizId     String
  fieldName String   @db.VarChar(64)
  createdAt DateTime @default(now())

  file UploadFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([bizType, bizId])
  @@index([fileId])
}

model DailyTask {
  id                    String    @id @default(cuid())
  tenantId              String
  mediaAccountId        String
  platform              String    @db.VarChar(32) // media_platform
  title                 String    @db.VarChar(255)
  postId                String?   @db.VarChar(64)
  authorName            String?   @db.VarChar(100)
  videoUrl              String
  coverFileId           String?
  coverUrl              String?
  copywriting           String?
  commentRequirement    String?
  commentExample        String?
  targetCommentCount    Int
  rewardAmount          Int       @default(0)
  claimedCommentCount   Int       @default(0)
  completedCommentCount Int       @default(0)
  publishedAt           DateTime?
  stepConfig            Json?
  status                String    @default("DRAFT") @db.VarChar(32) // daily_task_status
  distributionScope     String    @default("TENANT") @db.VarChar(32) // TENANT / GROUP
  distributionGroupId   String?
  allowGroupCollaboration Boolean @default(false)
  // 团长分佣为任务发布时的财务快照：rewardAmount 始终表示成员端可见/可结算金额。
  // taskBudgetAmount 是管理端输入的任务金额；INCLUDED 模式会从中扣除团长佣金，EXTRA 模式则额外计入团长佣金。
  commissionEnabled     Boolean   @default(false)
  commissionRuleId      String?
  taskBudgetAmount      Int       @default(0)
  commissionMode        String?   @db.VarChar(16) // INCLUDED / EXTRA
  commissionRuleType    String?   @db.VarChar(16) // PERCENT / FIXED
  commissionRuleValue   Int?
  commissionAmount      Int       @default(0)
  commissionGroupId     String?
  commissionLeaderUserId String?
  remark                String?
  dispatchedAt          DateTime?
  completedAt           DateTime?
  deletedAt             DateTime?
  // 测试任务标记：仅在测试环境开启 ALLOW_TEST_DATA_PURGE 后，允许清理已领取/已结算等完整测试链路。
  isTestData            Boolean   @default(false)
  testMarkedAt          DateTime?
  testMarkedById        String?
  // 新测试任务必须明确归属一个测试批次；清理范围只按批次，不再递归猜测关联关系。
  testBatchId           String?
  createdById           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  mediaAccount MediaAccount         @relation(fields: [mediaAccountId], references: [id])
