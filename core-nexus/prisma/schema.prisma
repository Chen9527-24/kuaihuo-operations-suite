  ingestKey                String   @unique @db.VarChar(64)
  clientMessageId          String   @db.VarChar(256)
  sourceClientId           String   @db.VarChar(128)
  localConversationId      String   @db.VarChar(128)
  senderRole               String   @db.VarChar(32)
  actorSource              String   @default("") @db.VarChar(64)
  attributionConfidence    String   @default("") @db.VarChar(32)
  messageType              String   @default("unknown") @db.VarChar(32)
  textContent              String   @default("")
  typePlaceholder          String   @default("") @db.VarChar(64)
  sequenceIndex            Int      @default(0)
  historyKind              String   @default("") @db.VarChar(32)
  timeAccuracy             String   @default("") @db.VarChar(32)
  observedAt               DateTime
  payloadFingerprint       String   @default("") @db.VarChar(128)
  replyAttemptId           String   @default("") @db.VarChar(256)
  replyTraceId             String   @default("") @db.VarChar(512)
  generationSource         String   @default("") @db.VarChar(64)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  conversation             DialogueConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, observedAt])
  @@index([tenantId, robotId, observedAt])
  @@index([tenantId, replyAttemptId])
  @@index([tenantId, replyTraceId])
  @@index([clientMessageId])
}

model DialogueSyncWatermark {
  id                       String   @id @default(cuid())
  tenantId                 String
  robotId                  String
  sourceClientId           String   @db.VarChar(128)
  localConversationId      String   @db.VarChar(128)
  deletedBeforeAt          DateTime
  reason                   String   @default("USER_DELETE") @db.VarChar(32)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([tenantId, robotId, sourceClientId, localConversationId])
  @@index([tenantId, robotId, updatedAt])
}
