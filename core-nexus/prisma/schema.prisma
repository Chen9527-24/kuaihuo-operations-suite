  createdById              String
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant                 Tenant                         @relation(fields: [tenantId], references: [id])
  createdBy              User                           @relation("IndustryAiRobotCreator", fields: [createdById], references: [id])
  capabilityPack         IndustryAiCapabilityPack       @relation(fields: [capabilityPackId], references: [id])
  capabilityPackVersion  IndustryAiCapabilityPackVersion @relation(fields: [capabilityPackVersionId], references: [id])
  testSessions           IndustryAiTestSession[]
  fixedReplyRules       IndustryAiFixedReplyRule[]

  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([capabilityPackId])
  @@index([capabilityPackVersionId])
  @@index([deletedAt])
}

model IndustryAiFixedReplyRule {
  id               String    @id @default(cuid())
  tenantId         String
  robotId          String
  name             String    @db.VarChar(100)
  channel          String    @default("BOTH") @db.VarChar(16) // DM / COMMENT / BOTH
  matchType        String    @db.VarChar(32) // EXACT / CONTAINS / KEYWORD_COMBINATION
  triggerPhrases   Json      @default("[]")
  requiredKeywords Json      @default("[]")
  excludedKeywords Json      @default("[]")
