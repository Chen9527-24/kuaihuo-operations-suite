# 复制为 .env 后填写，真实 .env 不应提交。字段说明见 docs/CONFIGURATION.md。
# 必填空值：DATABASE_URL、JWT_ACCESS_SECRET、JWT_REFRESH_SECRET。
# 使用本地 Compose 时还需 POSTGRES_PASSWORD；首次初始化需 SEED_ADMIN_USERNAME/PASSWORD。

# 应用与本地依赖
NODE_ENV=development
PORT=3000
APP_NAME=Core Nexus
APP_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:3000
WEBSITE_BASE_URL=
API_BASE_URL=http://localhost:3000
APP_TRUST_PROXY_HOPS=0
POSTGRES_DB=core_nexus
POSTGRES_USER=core_nexus
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
# 自行填写：postgresql://用户名:URL编码后的密码@127.0.0.1:5432/数据库名?schema=public
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# JWT 每项分别填写随机密钥，至少 32 字符，两个值必须不同
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d
HASH_SALT_ROUNDS=10

# 初始化账号：没有默认密码。seed 仅用于已确认的开发数据库
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_TENANT_CODE=ADMIN-TENANT-DEFAULT
SEED_ADMIN_TENANT_NAME=管理员租户
ALLOW_PRODUCTION_SEED=false
# 仅手工重置管理员密码时填写
ADMIN_RESET_USERNAME=
ADMIN_RESET_PASSWORD=

# 文件：默认本地存储，不需要云账户
UPLOAD_DRIVER=local
UPLOAD_MAX_FILE_SIZE_MB=20
LOCAL_UPLOAD_DIR=uploads
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_CDN_BASE_URL=
OSS_OBJECT_PREFIX=uploads
TENCENT_COS_ENABLED=false
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
TENCENT_COS_PREFIX=media
TENCENT_COS_SCHEME=https
TENCENT_COS_SIGNED_URL_TTL_SECONDS=600
TENCENT_COS_THUMBNAIL_URL_TTL_SECONDS=3600
TENCENT_COS_PRIVATE_SCENES=
TENCENT_COS_THUMBNAIL_MAX_LONG_EDGE=320
TENCENT_COS_THUMBNAIL_QUALITY=80

# DeepSeek：不填写 Key 时不能使用模型生成功能
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=600000

# Coze 兼容路径：需要自己的凭据和工作流。本项目不包含云端工作流资产
COZE_API_BASE_URL=https://api.coze.cn
COZE_API_PAT=
COZE_PERSONAL_ACCESS_TOKEN=
COZE_SERVICE_ACCESS_TOKEN=
COZE_AUTH_MODE=
COZE_OAUTH_APP_ID=
COZE_OAUTH_PUBLIC_KEY_ID=
COZE_OAUTH_PRIVATE_KEY=
COZE_OAUTH_AUDIENCE=api.coze.cn
COZE_OAUTH_DURATION_SECONDS=3600
COZE_COMMENT_REPLY_WORKFLOW_ID=
COZE_COMMENT_INTENT_WORKFLOW_ID=
COZE_INTERCEPT_WORK_DECISION_WORKFLOW_ID=
COZE_DM_CHAT_WORKFLOW_ID=
COZE_DM_CHAT_BOT_ID=
COZE_DM_CHAT_RETRY_ATTEMPTS=2
COZE_COMMENT_INTENT_BATCH_SIZE=20
COZE_COMMENT_INTENT_TIMEOUT_MS=600000
COZE_AUTO_REPLY_TIMEOUT_MS=600000

# 客服追踪与数据保留策略；清理开关默认关闭
CUSTOMER_SERVICE_JSON_MAX_BYTES=524288
CUSTOMER_SERVICE_TUNING_RETENTION_DAYS=180
CUSTOMER_SERVICE_RAW_OUTPUT_RETENTION_DAYS=90
CUSTOMER_SERVICE_CALIBRATION_COMPACT_DAYS=180
CUSTOMER_SERVICE_GOVERNANCE_BATCH_SIZE=100
CUSTOMER_SERVICE_GOVERNANCE_PURGE_ENABLED=false
CUSTOMER_SERVICE_RUNTIME_IDEMPOTENCY_RETENTION_DAYS=30
CUSTOMER_SERVICE_LONG_HORIZON_STATE_V2=true

# 管理员发送账号停用通知时配置。默认使用模拟发送。
SMS_PROVIDER=mock
SMS_ENABLED=true
SMS_NOTIFICATION_RESEND_INTERVAL_SECONDS=60
SMS_NOTIFICATION_PHONE_DAILY_LIMIT=20
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_EXTEND_CODE=
TENCENT_SMS_TEMPLATE_ACCOUNT_DISABLED_ID=

# 可选小程序与公众号 JS-SDK 接入
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
WECHAT_MINI_CODE_PAGE=pages/Home
WECHAT_MINI_ENV_VERSION=release
WECHAT_SCENE_TTL_SECONDS=2592000
MINI_PROGRAM_FORCE_MODE=
MINI_PROGRAM_AUDIT_VERSION=
MINI_PROGRAM_AUDIT_VERSIONS=
MINI_PROGRAM_AUDIT_ENABLED=false
WECHAT_MP_APPID=
WECHAT_MP_SECRET=

# 官网询盘：建议配置独立随机盐；不填时使用JWT密钥作为后备
WEBSITE_CONFIG_MAX_BYTES=262144
WEBSITE_CONTACT_IP_HOURLY_LIMIT=10
WEBSITE_CONTACT_DAILY_LIMIT=5
WEBSITE_IP_HASH_SALT=
