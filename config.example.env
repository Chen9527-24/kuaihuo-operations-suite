# Fill this one file, save as config.local.env, then run python3 scripts/configure.py.
# Do not commit config.local.env. Each PREFIX__KEY is written only to that project.
# Database and JWT fields are required; external services are optional and use your own accounts.

# ==================== core-nexus ====================
# 复制为 .env 后填写，真实 .env 不应提交。字段说明见 docs/CONFIGURATION.md。
# 必填空值：DATABASE_URL、JWT_ACCESS_SECRET、JWT_REFRESH_SECRET。
# 使用本地 Compose 时还需 POSTGRES_PASSWORD；首次初始化需 SEED_ADMIN_USERNAME/PASSWORD。

# 应用与本地依赖
CORE__NODE_ENV=development
CORE__PORT=3000
CORE__APP_NAME=Core Nexus
CORE__APP_ORIGIN=http://localhost:5173
CORE__APP_BASE_URL=http://localhost:3000
CORE__WEBSITE_BASE_URL=
CORE__API_BASE_URL=http://localhost:3000
CORE__APP_TRUST_PROXY_HOPS=0
CORE__POSTGRES_DB=core_nexus
CORE__POSTGRES_USER=core_nexus
CORE__POSTGRES_PASSWORD=
CORE__POSTGRES_PORT=5432
CORE__REDIS_PORT=6379
# 自行填写：postgresql://用户名:URL编码后的密码@127.0.0.1:5432/数据库名?schema=public
CORE__DATABASE_URL=
CORE__REDIS_URL=redis://127.0.0.1:6379

# JWT 每项分别填写随机密钥，至少 32 字符，两个值必须不同
CORE__JWT_ACCESS_SECRET=
CORE__JWT_REFRESH_SECRET=
CORE__JWT_ACCESS_EXPIRES_IN=7d
CORE__JWT_REFRESH_EXPIRES_IN=7d
CORE__HASH_SALT_ROUNDS=10

# 初始化账号：没有默认密码。seed 仅用于已确认的开发数据库
CORE__SEED_ADMIN_USERNAME=
CORE__SEED_ADMIN_PASSWORD=
CORE__SEED_ADMIN_TENANT_CODE=ADMIN-TENANT-DEFAULT
CORE__SEED_ADMIN_TENANT_NAME=管理员租户
CORE__ALLOW_PRODUCTION_SEED=false
# 仅手工重置管理员密码时填写
CORE__ADMIN_RESET_USERNAME=
CORE__ADMIN_RESET_PASSWORD=

# 文件：默认本地存储，不需要云账户
CORE__UPLOAD_DRIVER=local
CORE__UPLOAD_MAX_FILE_SIZE_MB=20
CORE__LOCAL_UPLOAD_DIR=uploads
CORE__OSS_REGION=
CORE__OSS_BUCKET=
CORE__OSS_ACCESS_KEY_ID=
CORE__OSS_ACCESS_KEY_SECRET=
CORE__OSS_ENDPOINT=
CORE__OSS_CDN_BASE_URL=
CORE__OSS_OBJECT_PREFIX=uploads
CORE__TENCENT_COS_ENABLED=false
CORE__TENCENT_COS_SECRET_ID=
CORE__TENCENT_COS_SECRET_KEY=
CORE__TENCENT_COS_REGION=ap-guangzhou
CORE__TENCENT_COS_BUCKET=
CORE__TENCENT_COS_PREFIX=media
CORE__TENCENT_COS_SCHEME=https
CORE__TENCENT_COS_SIGNED_URL_TTL_SECONDS=600
CORE__TENCENT_COS_THUMBNAIL_URL_TTL_SECONDS=3600
CORE__TENCENT_COS_PRIVATE_SCENES=
CORE__TENCENT_COS_THUMBNAIL_MAX_LONG_EDGE=320
CORE__TENCENT_COS_THUMBNAIL_QUALITY=80

# DeepSeek：不填写 Key 时不能使用模型生成功能
CORE__DEEPSEEK_API_KEY=
CORE__DEEPSEEK_BASE_URL=https://api.deepseek.com
CORE__DEEPSEEK_MODEL=deepseek-chat
CORE__DEEPSEEK_TIMEOUT_MS=600000

# Coze 兼容路径：需要自己的凭据和工作流。本项目不包含云端工作流资产
CORE__COZE_API_BASE_URL=https://api.coze.cn
CORE__COZE_API_PAT=
CORE__COZE_PERSONAL_ACCESS_TOKEN=
CORE__COZE_SERVICE_ACCESS_TOKEN=
CORE__COZE_AUTH_MODE=
CORE__COZE_OAUTH_APP_ID=
CORE__COZE_OAUTH_PUBLIC_KEY_ID=
CORE__COZE_OAUTH_PRIVATE_KEY=
CORE__COZE_OAUTH_AUDIENCE=api.coze.cn
CORE__COZE_OAUTH_DURATION_SECONDS=3600
CORE__COZE_COMMENT_REPLY_WORKFLOW_ID=
CORE__COZE_COMMENT_INTENT_WORKFLOW_ID=
CORE__COZE_INTERCEPT_WORK_DECISION_WORKFLOW_ID=
CORE__COZE_DM_CHAT_WORKFLOW_ID=
CORE__COZE_DM_CHAT_BOT_ID=
CORE__COZE_DM_CHAT_RETRY_ATTEMPTS=2
CORE__COZE_COMMENT_INTENT_BATCH_SIZE=20
CORE__COZE_COMMENT_INTENT_TIMEOUT_MS=600000
CORE__COZE_AUTO_REPLY_TIMEOUT_MS=600000

# 客服追踪与数据保留策略；清理开关默认关闭
CORE__CUSTOMER_SERVICE_JSON_MAX_BYTES=524288
CORE__CUSTOMER_SERVICE_TUNING_RETENTION_DAYS=180
CORE__CUSTOMER_SERVICE_RAW_OUTPUT_RETENTION_DAYS=90
CORE__CUSTOMER_SERVICE_CALIBRATION_COMPACT_DAYS=180
CORE__CUSTOMER_SERVICE_GOVERNANCE_BATCH_SIZE=100
CORE__CUSTOMER_SERVICE_GOVERNANCE_PURGE_ENABLED=false
CORE__CUSTOMER_SERVICE_RUNTIME_IDEMPOTENCY_RETENTION_DAYS=30
CORE__CUSTOMER_SERVICE_LONG_HORIZON_STATE_V2=true

# 管理员发送账号停用通知时配置。默认使用模拟发送。
CORE__SMS_PROVIDER=mock
CORE__SMS_ENABLED=true
CORE__SMS_NOTIFICATION_RESEND_INTERVAL_SECONDS=60
CORE__SMS_NOTIFICATION_PHONE_DAILY_LIMIT=20
CORE__TENCENT_SMS_SECRET_ID=
CORE__TENCENT_SMS_SECRET_KEY=
CORE__TENCENT_SMS_SDK_APP_ID=
CORE__TENCENT_SMS_SIGN_NAME=
CORE__TENCENT_SMS_REGION=ap-guangzhou
CORE__TENCENT_SMS_EXTEND_CODE=
CORE__TENCENT_SMS_TEMPLATE_ACCOUNT_DISABLED_ID=

# 可选小程序与公众号 JS-SDK 接入
CORE__WECHAT_MINI_APPID=
CORE__WECHAT_MINI_SECRET=
CORE__WECHAT_MINI_CODE_PAGE=pages/Home
CORE__WECHAT_MINI_ENV_VERSION=release
CORE__WECHAT_SCENE_TTL_SECONDS=2592000
CORE__MINI_PROGRAM_FORCE_MODE=
CORE__MINI_PROGRAM_AUDIT_VERSION=
CORE__MINI_PROGRAM_AUDIT_VERSIONS=
CORE__MINI_PROGRAM_AUDIT_ENABLED=false
CORE__WECHAT_MP_APPID=
CORE__WECHAT_MP_SECRET=

# 官网询盘：建议配置独立随机盐；不填时使用JWT密钥作为后备
CORE__WEBSITE_CONFIG_MAX_BYTES=262144
CORE__WEBSITE_CONTACT_IP_HOURLY_LIMIT=10
CORE__WEBSITE_CONTACT_DAILY_LIMIT=5
CORE__WEBSITE_IP_HASH_SALT=

# ==================== kf-pc ====================
# 复制为 .env.development（本地）或 .env.production（构建），按自己的服务填写。
# VITE_* 会进入浏览器，不要填写密码、Token 或云服务密钥。
PC__VITE_API_BASE_URL=/api/v1
PC__VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# 相对文件URL默认同源；独立文件服务可填其公开根地址。
PC__VITE_ASSET_BASE_URL=

# ==================== ucp ====================
# Copy to .env. Configure your own Core Nexus; never commit .env.
UCP__CORE_NEXUS_API_BASE_URL=http://localhost:3000

UCP__DM_ACTIVE_SCAN_INTERVAL_MS=1200
UCP__DM_TAB_SCAN_INTERVAL_MS=3000
UCP__DM_IDLE_SCAN_MIN_MS=40000
UCP__DM_IDLE_SCAN_MAX_MS=90000
UCP__DM_IDLE_LOG_EVERY_N=1
UCP__DM_IDLE_HEARTBEAT_INTERVAL_MS=90000
UCP__DM_DEBUG_VERBOSE=0

# Optional legacy Coze path. Disabled unless explicitly enabled AND both fields set.
# Normal production replies use Core Nexus and its own AI configuration.
UCP__COZE_ENABLED=0
UCP__COZE_API_URL=https://api.coze.cn/v1/workflow/run
UCP__COZE_WORKFLOW_ID=
UCP__COZE_TOKEN=
UCP__COZE_INPUT_KEY=input

# ==================== interception-bot ====================
# Copy to .env. Configure your own backend; log in through the GUI.
INTERCEPTION__CORE_NEXUS_API_BASE_URL=http://localhost:3000
INTERCEPTION__ACS_HTTP_TRUST_ENV=0

# Install Chromium once with: python -m playwright install chromium
INTERCEPTION__ACS_PLAYWRIGHT_AUTO_INSTALL=0
INTERCEPTION__ACS_ALLOW_SYSTEM_BROWSER_FALLBACK=0
INTERCEPTION__ACS_GUI_EXTERNAL_BROWSER=0
INTERCEPTION__ACS_GUI_VERBOSE_LOG=0

# Speech recognition is optional. Set a local faster-whisper model folder and ffmpeg path.
# Without a model/path, speech mode gives a configuration error instead of downloading.
INTERCEPTION__WHISPER_MODEL=
INTERCEPTION__WHISPER_DEVICE=cpu
INTERCEPTION__WHISPER_COMPUTE_TYPE=int8
INTERCEPTION__TRANSCRIPT_LANGUAGE=zh
INTERCEPTION__ACS_FFMPEG_PATH=
INTERCEPTION__ACS_ALLOW_WHISPER_DOWNLOAD=0

# Headless collection in GUI; no independent visible browser by default.
INTERCEPTION__ACS_SPEECH_HEADLESS=1
INTERCEPTION__ACS_SPEECH_RETRY_VISIBLE_ON_FAIL=0
